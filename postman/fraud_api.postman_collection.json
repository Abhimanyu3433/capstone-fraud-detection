      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('has probability', () => pm.expect(pm.response.json()).to.have.property('fraud_probability'));"
            ]
          }
        }
