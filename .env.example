# Copy to .env (git-ignored) or set in your shell. Never commit real values.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-fraud-capstone
AZURE_ML_WORKSPACE=mlw-fraud-capstone
AZURE_ENDPOINT_NAME=   # optional; default fraud-ep-<workspace hash>
AZURE_MODEL_NAME=fraud-detection-model
AZURE_INSTANCE_TYPE=Standard_DS3_v2
# For FastAPI /predict/azure and mlops.test_endpoint
AZURE_ENDPOINT_URL=
AZURE_ENDPOINT_KEY=
# Optional overrides for the API
MODEL_PATH=
FRAUD_THRESHOLD=
