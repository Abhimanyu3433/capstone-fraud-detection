{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI (uvicorn --reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api.main:app", "--reload", "--port", "8000"],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"]
    },
    {
      "name": "Validate Colab hand-off",
      "type": "debugpy",
      "request": "launch",
      "module": "src.config"
    },
    {
      "name": "MLflow tracking (local dry run)",
      "type": "debugpy",
      "request": "launch",
      "module": "mlops.track_experiments",
      "args": ["--local"]
    }
  ]
}
